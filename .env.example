# Copy these into Railway > your service > Variables. Never commit real values to GitHub.
# Comments are on their own lines so nothing ends up inside a value.

# Required
ANTHROPIC_API_KEY=
DATA_DIR=/data
# Password for the dashboard controls (Railway > Settings > Networking > Generate Domain gives you the link)
DASHBOARD_PASSWORD=

# Strategy: dip_breakout (default), combo, btc_trend, btc_dip, sol_breakout
STRATEGY=dip_breakout
AGENT_NAME=Route

# Starting state only. After the first run, the dashboard controls these.
# TRADER_ENABLED / TWEETER_ENABLED: on or off. MODE: paper or live. POST_MODE: dry (drafts) or live.
TRADER_ENABLED=on
MODE=paper
TWEETER_ENABLED=on
POST_MODE=dry
# Must be yes before the dashboard allows live trading (also needs the wallet and SWAPIO_API_URL)
ALLOW_LIVE_TRADING=no

# Timing: trading agent checks hourly and acts once per daily close (00:00 UTC)
INTERVAL_MINUTES=60
TWEETER_INTERVAL_MINUTES=5

# on = Solscan link in tweets (X charges more per post with a link)
INCLUDE_TX_LINK=off
# on = blocks all swaps whatever the dashboard says (emergency override)
KILL_SWITCH=off
PAPER_START_USDC=300

# Idle USDC lending: paper (simulated), off, or live (Kamino, needs dev wiring)
LEND_MODE=paper
LEND_PAPER_APY=0.04
CASH_BUFFER_USD=25

# Models
ANALYST_MODEL=claude-sonnet-5-5
REVIEWER_MODEL=claude-sonnet-5-5
POSTER_MODEL=claude-haiku-5-5

# Hard limits
MAX_TRADE_USD=400
MAX_TRADES_PER_DAY=4
MAX_SLIPPAGE_BPS=100
MAX_PRICE_GAP_PCT=2
MIN_SOL_FOR_FEES=0.02

# Live trading only. Fresh wallet, small balance. Secret key as a JSON array, e.g. [12,34,...]
WALLET_ADDRESS=
WALLET_SECRET_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SWAPIO_API_URL=
SWAPIO_API_KEY=

# Live tweets only
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
